QMainWindow, QWidget {
    background: #111923;
    color: #e8edf5;
}

QLineEdit, QPlainTextEdit, QTextEdit, QComboBox, QTableWidget, QTreeWidget, QGraphicsView {
    background: #182431;
    color: #e8edf5;
    border: 1px solid #38506a;
    selection-background-color: #32669b;
    selection-color: #ffffff;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QComboBox:focus,
QTableWidget:focus, QTreeWidget:focus, QGraphicsView:focus {
    border-color: #6ca9e8;
}

QPushButton {
    padding: 6px 10px;
    background: #263a52;
    border: 1px solid #46627f;
    border-radius: 4px;
}

QPushButton:hover { background: #32669b; }
QPushButton:checked { background: #284c6c; border-color: #7fa8cd; }
QPushButton:disabled { background: #1a2531; color: #71879d; border-color: #293b4d; }

QGroupBox {
    font-weight: bold;
    border: 1px solid #344a62;
    border-radius: 5px;
    margin-top: 10px;
    padding-top: 10px;
}

QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 4px; }
QTabBar::tab { background: #182431; padding: 7px 12px; border: 1px solid #344a62; }
QTabBar::tab:selected { background: #263a52; border-bottom-color: #6ca9e8; }
QToolBar { background: #111923; border-bottom: 1px solid #344a62; spacing: 4px; }
QHeaderView::section { background: #263a52; color: #e8edf5; padding: 5px; border: 1px solid #344a62; }
QProgressBar { border: 1px solid #38506a; border-radius: 3px; text-align: center; }
QProgressBar::chunk { background: #32669b; }

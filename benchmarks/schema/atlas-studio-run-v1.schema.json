{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schema/atlas-studio-run-v1.schema.json",
  "title": "Atlas local studio JSONL run stream version 1",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "studio_schema_version", "trace_schema_version"],
      "properties": {
        "record_type": { "const": "header" },
        "studio_schema_version": { "const": 1 },
        "trace_schema_version": { "const": 1 }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "node_id", "task_id", "name", "resource", "priority"],
      "properties": {
        "record_type": { "const": "task" },
        "node_id": { "type": "string", "minLength": 1 },
        "task_id": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "resource": { "enum": ["cpu", "gpu"] },
        "priority": { "type": "integer", "minimum": 0 }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "sequence", "timestamp_ns", "kind", "source", "priority", "previous_state", "state", "host_duration_ns"],
      "properties": {
        "record_type": { "const": "event" },
        "sequence": { "type": "integer", "minimum": 0 },
        "timestamp_ns": { "type": "integer", "minimum": 0 },
        "kind": { "enum": ["scheduler_started", "scheduler_finished", "task_ready", "policy_decision", "task_selected", "task_resumed", "submission_requested", "submission_accepted", "submission_rejected", "backend_started", "backend_finished", "completion_observed", "task_paused", "cancellation_requested", "cancellation_applied", "task_succeeded", "task_failed", "policy_failed", "infrastructure_failed"] },
        "source": { "enum": ["scheduler", "cpu_executor", "vulkan_executor"] },
        "graph_id": { "type": "integer", "minimum": 0 },
        "task_id": { "type": "integer", "minimum": 1 },
        "resource": { "enum": ["cpu", "gpu"] },
        "work_unit_index": { "type": "integer", "minimum": 0 },
        "worker_index": { "type": "integer", "minimum": 0 },
        "ready_count": { "type": "integer", "minimum": 0 },
        "selected_index": { "type": "integer", "minimum": 0 },
        "priority": { "type": "integer", "minimum": 0 },
        "previous_state": { "$ref": "#/$defs/task_state" },
        "state": { "$ref": "#/$defs/task_state" },
        "host_duration_ns": { "type": "integer", "minimum": 0 },
        "device_duration_ns": { "type": "integer", "minimum": 0 }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "status", "executed_task_count", "execution_time_ns", "scheduler_active_ns", "immediate_slice_switch_ns", "immediate_slice_switch_count", "device", "timestamp_supported", "tasks"],
      "properties": {
        "record_type": { "const": "result" },
        "status": { "enum": ["Success", "TaskFailed", "ExecutorUnavailable", "InvalidGraph", "GraphNotFinalised", "Cancelled", "PolicyError", "Unknown"] },
        "executed_task_count": { "type": "integer", "minimum": 0 },
        "execution_time_ns": { "type": "integer", "minimum": 0 },
        "scheduler_active_ns": { "type": "integer", "minimum": 0 },
        "immediate_slice_switch_ns": { "type": "integer", "minimum": 0 },
        "immediate_slice_switch_count": { "type": "integer", "minimum": 0 },
        "device": { "type": "string", "minLength": 1 },
        "timestamp_supported": { "type": "boolean" },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/task_result" } }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "message"],
      "properties": {
        "record_type": { "const": "error" },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "status", "accepted_events", "dropped_events", "complete"],
      "properties": {
        "record_type": { "const": "footer" },
        "status": { "enum": ["success", "failed", "abandoned"] },
        "accepted_events": { "type": "integer", "minimum": 0 },
        "dropped_events": { "type": "integer", "minimum": 0 },
        "complete": { "const": true }
      }
    }
  ],
  "$defs": {
    "task_state": { "enum": ["unknown", "blocked", "ready", "running", "paused", "success", "failure", "cancelled"] },
    "task_result": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "task_id", "state", "execution_duration_ns", "completed_work_units", "total_work_units", "ready_wait_ns", "selection_bypass_count"],
      "properties": {
        "node_id": { "type": "string", "minLength": 1 },
        "task_id": { "type": "integer", "minimum": 1 },
        "state": { "$ref": "#/$defs/task_state" },
        "execution_duration_ns": { "type": "integer", "minimum": 0 },
        "completed_work_units": { "type": "integer", "minimum": 0 },
        "total_work_units": { "type": "integer", "minimum": 1 },
        "ready_wait_ns": { "type": "integer", "minimum": 0 },
        "selection_bypass_count": { "type": "integer", "minimum": 0 },
        "response_duration_ns": { "type": "integer", "minimum": 0 },
        "device_execution_duration_ns": { "type": "integer", "minimum": 0 }
      }
    }
  }
}

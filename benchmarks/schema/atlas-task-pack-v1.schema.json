{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schema/atlas-task-pack-v1.schema.json",
  "title": "Atlas trusted native task pack version 1",
  "$comment": "The library additionally enforces UTF-8 byte lengths, unique IDs/platform triples/referenced paths, ordered field bounds, defaults within declared bounds/enums, shader/result cross-references, file safety and byte/count limits. These relational and filesystem constraints are not expressible in standard JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "abi_version",
    "pack_id",
    "version",
    "platforms",
    "shaders",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "abi_version": {
      "const": 1
    },
    "pack_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000]*$"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "platform",
              "architecture",
              "library"
            ],
            "properties": {
              "platform": {
                "const": "linux"
              },
              "architecture": {
                "enum": [
                  "x86_64",
                  "aarch64"
                ]
              },
              "library": {
                "allOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "^(?!/)(?!.*[\\\\:\\u0000])(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
                  },
                  {
                    "pattern": "\\.so$"
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "platform",
              "architecture",
              "library"
            ],
            "properties": {
              "platform": {
                "const": "windows"
              },
              "architecture": {
                "enum": [
                  "x86_64",
                  "aarch64"
                ]
              },
              "library": {
                "allOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "^(?!/)(?!.*[\\\\:\\u0000])(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
                  },
                  {
                    "pattern": "\\.dll$"
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "shaders": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [

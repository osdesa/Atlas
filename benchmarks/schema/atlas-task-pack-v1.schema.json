                  "minimum": 0,
                  "maximum": 4294967295
                },
                "access": {
                  "enum": [
                    "read_only",
                    "write_only",
                    "read_write"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "oneOf": [

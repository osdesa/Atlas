{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schema/atlas-benchmark-result-v1.schema.json",
  "title": "Atlas benchmark JSON Lines record version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_schema_version", "experiment_id", "seed", "repetition", "manifest", "environment", "result", "metrics", "tasks"],
  "properties": {
    "result_schema_version": { "const": 1 },
    "experiment_id": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer", "minimum": 0 },
    "repetition": { "type": "integer", "minimum": 0 },
    "manifest": { "$ref": "atlas-benchmark-manifest-v1.schema.json" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atlas_version", "git_revision", "compiler", "build_type", "operating_system", "worker_count", "gpu_device", "gpu_api_version"],
      "properties": {
        "atlas_version": { "type": "string" },
        "git_revision": { "type": "string" },
        "compiler": { "type": "string" },
        "build_type": { "type": "string" },
        "operating_system": { "type": "string" },
        "worker_count": { "type": "integer", "minimum": 1 },
        "gpu_device": { "type": ["string", "null"] },
        "gpu_api_version": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "executed_task_count", "completion_time_us", "scheduler_active_us", "immediate_slice_switch_us", "immediate_slice_switch_count"],
      "properties": {
        "status": { "type": "string" },
        "executed_task_count": { "type": "integer", "minimum": 0 },
        "completion_time_us": { "type": "integer", "minimum": 0 },
        "scheduler_active_us": { "type": "integer", "minimum": 0 },
        "immediate_slice_switch_us": { "type": "integer", "minimum": 0 },
        "immediate_slice_switch_count": { "type": "integer", "minimum": 0 }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["throughput_tasks_per_second", "response_latency", "ready_wait", "scheduler_active_fraction", "immediate_slice_switch_mean_us", "cpu_busy_fraction", "gpu_host_busy_fraction", "gpu_timestamp_supported", "gpu_timestamp_busy_fraction", "cpu_jain_fairness", "gpu_jain_fairness"],
      "properties": {
        "throughput_tasks_per_second": { "type": "number", "minimum": 0 },
        "response_latency": { "$ref": "#/$defs/duration_distribution" },
        "ready_wait": { "$ref": "#/$defs/duration_distribution" },
        "scheduler_active_fraction": { "$ref": "#/$defs/optional_number" },
        "immediate_slice_switch_mean_us": { "$ref": "#/$defs/optional_number" },
        "cpu_busy_fraction": { "$ref": "#/$defs/optional_number" },
        "gpu_host_busy_fraction": { "$ref": "#/$defs/optional_number" },
        "gpu_timestamp_supported": { "const": false },
        "gpu_timestamp_busy_fraction": { "type": "null" },
        "cpu_jain_fairness": { "$ref": "#/$defs/optional_number" },
        "gpu_jain_fairness": { "$ref": "#/$defs/optional_number" }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "name", "resource", "priority", "burst", "state", "execution_us", "ready_wait_us", "response_us", "selection_bypasses", "completed_work_units", "total_work_units"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "name": { "type": "string" },
          "resource": { "enum": ["cpu", "gpu"] },
          "priority": { "type": "integer", "minimum": 0 },
          "burst": { "type": "integer", "minimum": 0 },
          "state": { "type": "string" },
          "execution_us": { "type": "integer", "minimum": 0 },
          "ready_wait_us": { "type": "integer", "minimum": 0 },
          "response_us": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
          "selection_bypasses": { "type": "integer", "minimum": 0 },
          "completed_work_units": { "type": "integer", "minimum": 0 },
          "total_work_units": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "optional_number": { "type": ["number", "null"], "minimum": 0 },
    "duration_distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mean_us", "p50_us", "p95_us", "max_us"],
      "properties": {
        "mean_us": { "$ref": "#/$defs/optional_number" },
        "p50_us": { "$ref": "#/$defs/optional_number" },
        "p95_us": { "$ref": "#/$defs/optional_number" },
        "max_us": { "$ref": "#/$defs/optional_number" }
      }
    }
  }
}

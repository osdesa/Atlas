{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schema/atlas-evaluation-result-v1.schema.json",
  "title": "Atlas final evaluation result version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["evaluation_schema_version", "study_id", "suite_sha256", "source_revision", "environments", "analysis", "questions"],
  "properties": {
    "evaluation_schema_version": { "const": 1 },
    "study_id": { "type": "string", "minLength": 1 },
    "suite_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_revision": { "type": "string", "minLength": 1 },
    "environments": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "analysis": { "type": "object" },
    "questions": { "type": "array", "minItems": 1, "items": { "type": "object" } }
  }
}

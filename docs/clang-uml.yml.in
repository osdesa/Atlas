compilation_database_dir: "@ATLAS_UML_ANALYSIS_BUILD_DIRECTORY@"
output_directory: "@ATLAS_UML_OUTPUT_DIRECTORY@"

generate_method_arguments: full
using_namespace: Atlas

diagrams:
  task:
    type: class
    glob:
      - src/Tasking/*.cpp
    include:
      context:
        - match:
            radius: 1
            pattern: Atlas::Task
    exclude:
      namespaces:
        - std
    plantuml:
      before:
        - skinparam backgroundColor transparent
        - skinparam class {
        - '  BackgroundColor #E0F2FE'
        - '  BorderColor #0284C7'
        - '  ArrowColor #64748B'
        - '  FontColor #0F172A'
        - '}'

  task_handle:
    type: class
    glob:
      - src/Tasking/*.cpp
    include:
      context:
        - match:
            radius: 1

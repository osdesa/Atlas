#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly buffer Dimensions
{
    uint values[];
}
dimensions;

layout(binding = 1) buffer Output
{
    uint values[];
}
outputData;

void main()
{
    uint index = gl_GlobalInvocationID.x + dimensions.values[0] *
                 (gl_GlobalInvocationID.y + dimensions.values[1] * gl_GlobalInvocationID.z);
    if (index < outputData.values.length())
    {
        outputData.values[index] = outputData.values[index] * 1664525u + 1013904223u;
    }
}
